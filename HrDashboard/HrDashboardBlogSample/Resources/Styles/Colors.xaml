<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Accent palette tuned for dark teal backgrounds: lighter/brighter hues for strong contrast -->
    <Color x:Key="Accent1">#34D399</Color> <!-- Emerald 400 -->
    <Color x:Key="Accent2">#2DD4BF</Color> <!-- Teal 400 -->
    <Color x:Key="Accent3">#38BDF8</Color> <!-- Sky 400 -->
    <Color x:Key="Accent4">#A78BFA</Color> <!-- Violet 400 -->
    <Color x:Key="Accent5">#F472B6</Color> <!-- Pink 400 -->
    <Color x:Key="Accent6">#FBBF24</Color> <!-- Amber 400 -->
    <Color x:Key="Accent7">#FB7185</Color> <!-- Rose 400 -->
    <Color x:Key="Accent8">#4ADE80</Color> <!-- Green 400 -->

    <!-- Provide legacy keys used by Styles.xaml -->
    <Color x:Key="Primary">#8B5CF6</Color> <!-- maps to Accent3 -->
    <Color x:Key="PrimaryDark">#6D28D9</Color> <!-- maps to Accent8 -->
    <Color x:Key="PrimaryDarkText">#0B1220</Color>
    <Color x:Key="Secondary">#06B6D4</Color> <!-- maps to Accent6 -->
    <Color x:Key="MidnightBlue">#24113F</Color> <!-- used by Headline/SubHeadline -->
    <Color x:Key="Magenta">#DB2777</Color> <!-- optional legacy key -->

    <!-- Neutral scale for controls -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#0B0F19</Color>

    <!-- Compatibility keys used by Styles.xaml -->
    <Color x:Key="OffBlack">#121212</Color>
    <Color x:Key="SecondaryDarkText">#CAC3DA</Color>

    <!-- Theme-aware brushes using AppThemeBinding -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{AppThemeBinding Light=#F5F7FB, Dark=#1A0B2E}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{AppThemeBinding Light=#FFFFFF, Dark=#24113F}"/>
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{AppThemeBinding Light=#E8ECF3, Dark=#322057}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{AppThemeBinding Light=#212121, Dark=#FFFFFF}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{AppThemeBinding Light=#5C6B77, Dark=#CAC3DA}"/>

    <!-- Chart palette brushes -->
    <SolidColorBrush x:Key="ChartBrush1" Color="{StaticResource Accent1}"/>
    <SolidColorBrush x:Key="ChartBrush2" Color="{StaticResource Accent2}"/>
    <SolidColorBrush x:Key="ChartBrush3" Color="{StaticResource Accent3}"/>
    <SolidColorBrush x:Key="ChartBrush4" Color="{StaticResource Accent4}"/>
    <SolidColorBrush x:Key="ChartBrush5" Color="{StaticResource Accent5}"/>
    <SolidColorBrush x:Key="ChartBrush6" Color="{StaticResource Accent6}"/>
    <SolidColorBrush x:Key="ChartBrush7" Color="{StaticResource Accent7}"/>
    <SolidColorBrush x:Key="ChartBrush8" Color="{StaticResource Accent8}"/>
</ResourceDictionary>
